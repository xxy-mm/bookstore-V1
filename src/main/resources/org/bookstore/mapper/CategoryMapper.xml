<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.bookstore.mapper.CategoryMapper">

    <sql id="select category entity">
        select id, parent_id, name, sort, status, create_time, update_time
        from categories
    </sql>


    <select id="selectById" resultType="category">
        <include refid="select category entity"/>
        where id = #{id} order by sort, id
    </select>
    <select id="selectAll" resultType="org.bookstore.entity.Category">
        <include refid="select category entity"/>
        <where>
            <if test="status != null">
                status=#{status}
            </if>
        </where>
        order by sort, id
    </select>
    <select id="selectChildren" resultType="Category">
        <include refid="select category entity"/>
        where parent_id = #{parentId}
    </select>

</mapper>