<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.bookstore.mapper.CategoryMapper">

    <resultMap id="categoryResultMap" type="Category">
        <result column="parent_id" property="parentId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="select category entity">
        select id, parent_id, name, sort, status, create_time, update_time
        from categories
    </sql>


    <select id="findById" resultMap="categoryResultMap">
        <include refid="select category entity"/>
        where id = #{id} order by sort, id
    </select>
    <select id="findAll" resultType="org.bookstore.entity.Category">
        <include refid="select category entity"/>
        <where>
            <if test="status != null">
                status=#{status}
            </if>
        </where>
        order by sort, id
    </select>

</mapper>