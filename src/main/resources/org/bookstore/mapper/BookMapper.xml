<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.bookstore.mapper.BookMapper">

    <sql id="join books and categories">
        from books join categories on books.category_id = categories.id
    </sql>
    <sql id="select book entity">
        select books.id,
        books.category_id,
        books.title,
        books.author,
        books.publisher,
        books.isbn,
        books.cover,
        books.price,
        books.stock,
        books.description,
        books.status
        <include refid="join books and categories"/>
    </sql>
    <sql id="select book dto">
        select books.id,
        books.category_id,
        books.title,
        books.author,
        books.publisher,
        books.isbn,
        books.cover,
        books.price,
        books.stock,
        books.description,
        books.status, categories.name as categoryName
        <include refid="join books and categories"/>
    </sql>
    <select id="findById" resultType="bookDTO">
        <include refid="select book dto"/>
        where books.id = #{id}
    </select>
    <select id="findAll" resultType="book">
        <include refid="select book dto"/>
    </select>
    <select id="findAllByCategory" resultType="bookDTO">
        <include refid="select book dto"/>
        <where>
            <if test="categoryIds!=null and categoryIds.size() > 0">
                and category_id in
                <foreach collection="categoryIds" item="categoryId" open="(" close=")" separator=",">
                    #{categoryId}
                </foreach>
            </if>

            <if test="true">
                and categories.status = 1
            </if>
        </where>
        order by books.id limit #{limit} offset #{offset}
    </select>
    <select id="queryCountByCategoryId" resultType="java.lang.Long">
        select count(*) from books
        <where>
            <if test="categoryIds != null and categoryIds.size() > 0">
                and category_id in
                <foreach collection="categoryIds" separator="," close=")" open="(" item="categoryId">
                    #{categoryId}
                </foreach>
            </if>
        </where>
    </select>
</mapper>