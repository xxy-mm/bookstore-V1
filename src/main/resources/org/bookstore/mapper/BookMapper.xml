<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.bookstore.mapper.BookMapper">

    <resultMap id="bookResultMap" type="Book">
        <result column="category_id" property="categoryId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <sql id="select books with category name">
        select books.id, books.category_id, books.title, books.author, books.publisher, books.isbn, books.cover,
        books.price, books.stock, books.description,
        books.status from books join categories on books.category_id = categories.id
    </sql>
    <select id="findById" resultMap="bookResultMap">
        <include refid="select books with category name"/>
        where books.id = #{id}
    </select>
    <select id="findAll" resultMap="bookResultMap">
        <include refid="select books with category name"/>
    </select>
    <select id="findAllByCategory" resultType="org.bookstore.entity.Book">
        <include refid="select books with category name"/>
        where category_id = #{categoryId}
    </select>
</mapper>