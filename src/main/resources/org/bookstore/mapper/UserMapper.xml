<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.bookstore.mapper.UserMapper">

    <resultMap id="userEntityMap" type="user">
        <result property="updateTime" column="update_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <sql id="select user entity">
        SELECT id,
               username,
               password,
               nickname,
               email,
               phone,
               role,
               status,
               create_time,
               update_time
        FROM users
    </sql>
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, password, nickname, email, phone, role, status) VALUES (#{username}, #{password},
        #{nickname} #{email}, #{phone}, #{role}, #{status});
    </insert>
    <select id="findByUsername" resultMap="userEntityMap">
        <include refid="select user entity"/>
        WHERE username=#{username} limit 1
    </select>
</mapper>